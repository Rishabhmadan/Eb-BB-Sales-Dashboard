# Odoo Connection Configuration Template
# Rename this file to .env and fill in your actual credentials.
# Do NOT commit your completed .env file to version control.

ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-database-name
ODOO_USER=your-username-or-email
ODOO_API_KEY=your-api-key-or-password
